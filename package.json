{
  "name": "wishlist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_USE_EMULATORS=1 vite",
    "emulators": "npx firebase-tools emulators:start --only auth,firestore --project demo-wishlist",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:rules": "npx --yes firebase-tools@15.37.0 emulators:exec --only firestore --project demo-wishlist \"node tests/rules/basic.test.mjs && node tests/rules/group.test.mjs && node tests/rules/questions.test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
